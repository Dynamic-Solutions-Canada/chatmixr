<Page
    x:Class="ChatMixr.GameBar.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The widget's styles live here, not in App.xaml: UWP only auto-loads an App.xaml at the
         package root, and the widget's sits in GameBar/, so its resources are never loaded. -->
    <Page.Resources>
        <!-- Secondary text: captions, the status line, "In use" (DeviceRow takes it from StatusText). -->
        <Style x:Key="WidgetSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Page.Resources>

    <!-- Game Bar draws the widget's title bar and frame; this is only its content. -->
    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Style="{StaticResource WidgetSecondaryText}" Margin="0,0,0,8" TextWrapping="Wrap" />

        <!-- The scrollbar is drawn over the content; WidgetPage makes room for it only while it shows. -->
        <ScrollViewer x:Name="DeviceScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DeviceRows" Spacing="16" />
        </ScrollViewer>

        <StackPanel x:Name="VoiceChatPanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <ToggleSwitch x:Name="VoiceChatSwitch" Toggled="OnVoiceChatToggled" />
            <TextBlock x:Name="VoiceChatCaption" Style="{StaticResource WidgetSecondaryText}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- While ChatMixr isn't connected: say so, and offer to open it. -->
        <StackPanel x:Name="DisconnectedPanel" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <TextBlock x:Name="DisconnectedText" TextWrapping="Wrap" TextAlignment="Center" />
            <Button x:Name="OpenButton" HorizontalAlignment="Center" Click="OnOpenClicked" />
        </StackPanel>
    </Grid>
</Page>
