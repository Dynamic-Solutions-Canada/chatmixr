<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Styles for the rows, badges and notes built in code (CardRow, HeadsetBadge, EmptyState). Code
         applies them by key. A brush fetched from Application.Current.Resources follows Windows' theme,
         not the window's, so a light card would show in a dark window; {ThemeResource} in a setter
         follows the window's theme and updates when it changes. -->

    <!-- CardRow: the card -->
    <Style x:Key="CardRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10,12,10" />
    </Style>

    <!-- CardRow: the vertical bar at the card's left edge on rows that can be the current one (devices):
         the accent colour on the current one, a quiet neutral on the rest -->
    <Style x:Key="RowIndicatorStyle" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="CornerRadius" Value="1.5" />
        <Setter Property="Margin" Value="-6,0,9,0" />
        <Setter Property="Background" Value="{ThemeResource ControlStrongStrokeColorDisabledBrush}" />
    </Style>
    <Style x:Key="RowIndicatorCurrentStyle" TargetType="Border" BasedOn="{StaticResource RowIndicatorStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>

    <!-- CardRow: the kind icon, normal and current -->
    <Style x:Key="RowIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="RowIconCurrentStyle" TargetType="FontIcon" BasedOn="{StaticResource RowIconStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <!-- Secondary and quieter caption text: card captions, notes, empty lists, badge text -->
    <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="TertiaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- HeadsetBadge: the pill and its icon colours -->
    <Style x:Key="BadgePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="7,2,8,2" />
    </Style>
    <Style x:Key="BadgeIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="BadgeIconGoodStyle" TargetType="FontIcon" BasedOn="{StaticResource BadgeIconStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="BadgeIconLowStyle" TargetType="FontIcon" BasedOn="{StaticResource BadgeIconStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="BadgeIconCriticalStyle" TargetType="FontIcon" BasedOn="{StaticResource BadgeIconStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
</ResourceDictionary>
