<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <!-- Runs on Windows 10 22H2 too (the manifest's floor); APIs newer than that need a runtime check,
         which the platform analyzer enforces. -->
    <SupportedOSPlatformVersion>10.0.19045.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>$(SupportedOSPlatformVersion)</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RootNamespace>ChatMixr</RootNamespace>
    <AssemblyName>ChatMixr</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Configurations>Debug;Release</Configurations>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\ChatMixr.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- App.xaml is packaged as Tray/App.xbf, never at the package root. Windows' UWP XAML loads any
       App.xaml at the root by itself, so the Game Bar widget (UWP, same package) would load this WinUI 3
       one and crash. This app loads its App.xaml by its own address, so the move costs it nothing. -->
  <ItemGroup>
    <ApplicationDefinition Update="App.xaml" Link="Tray\App.xaml" />
  </ItemGroup>

  <!-- Shared tray / flyout / settings plumbing (git submodule) -->
  <ItemGroup>
    <ProjectReference Include="..\external\winui-app-kit\WinUIAppKit\WinUIAppKit.csproj" />
  </ItemGroup>

  <!-- NuGet packages (versions in Directory.Packages.props) -->
  <ItemGroup>
    <!-- System.Drawing for runtime tray-icon rendering -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />

    <!-- WinUI 3 (Windows App SDK); the manifest's Microsoft.WindowsAppRuntime dependency moves with it -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />

    <!-- Structured logging; the shared NLog.config is linked by the kit's build targets -->
    <PackageReference Include="NLog" />
  </ItemGroup>

  <!-- Content files to copy to output -->
  <ItemGroup>
    <None Remove="Resources\ChatMixr.ico" />
    <None Remove="Resources\ChatMixr.png" />
    <None Remove="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\ChatMixr.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\ChatMixr.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Generated by the kit's generate-notices.py (npm run generate:notices, HYG-3); ships in the package beside the app -->
    <Content Include="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Interface text: one JSON catalog per language, read by WinUIAppKit.Localization.UiText -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Catalogs\*.json" LogicalName="ChatMixr.Localization.%(Filename).json" />
  </ItemGroup>

  <!-- winui-app-kit's shared XAML: styles, the About page and the Settings rows -->
  <Import Project="..\external\winui-app-kit\Xaml\WinUIAppKit.Xaml.projitems" Label="Shared" />

  <!-- Shared "Our other apps" cross-promo page (submodule). Bundled data is the offline
       fallback; the page refreshes its public manifest at runtime. -->
  <Import Project="..\external\promo\PromotedApps.projitems" Label="Shared" />
</Project>
