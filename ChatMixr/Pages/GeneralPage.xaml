<Page
    x:Class="ChatMixr.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization"
    xmlns:cls="using:ChatMixr.Classes"
    xmlns:kitc="using:WinUIAppKit.Controls">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock l10n:Localize.Text="kit.settings.title" Style="{StaticResource PageTitleStyle}" />

            <!-- The kit's "settings were reset" notice goes here, after an unreadable settings file (CONF-2) -->
            <ContentPresenter x:Name="NoticeHost" />

            <TextBlock l10n:Localize.Text="settings.behaviour" Style="{StaticResource FirstSectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <kitc:StartupSetting x:Name="StartupRow" />
            </Border>

            <!-- ChatMixr's own switches, in a card of their own: the kit's Startup row above lays out its
                 switch differently (label above), and one card shouldn't mix the two -->
            <TextBlock l10n:Localize.Text="settings.devices-and-keys" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <cls:LabeledSwitch x:Name="AutoSwitchSwitch" Toggled="AutoSwitchSwitch_Toggled" />
                        <TextBlock l10n:Localize.Text="settings.auto-switch-note" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <cls:LabeledSwitch x:Name="ShortcutsSwitch" Toggled="ShortcutsSwitch_Toggled" />
                        <TextBlock x:Name="ShortcutsNote" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <!-- The two shortcuts: click to record a new combination, the arrow to restore the default -->
                        <Grid x:Name="ShortcutRows" ColumnSpacing="8" RowSpacing="6" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock l10n:Localize.Text="settings.shortcut-chat" VerticalAlignment="Center" />
                            <Button x:Name="ChatShortcutButton" Grid.Column="1" MinWidth="160" Click="ShortcutButton_Click"
                                    PreviewKeyDown="ShortcutButton_PreviewKeyDown" LostFocus="ShortcutButton_LostFocus" />
                            <Button x:Name="ChatShortcutReset" Grid.Column="2" Click="ShortcutReset_Click"
                                    l10n:Localize.Name="settings.shortcut-reset" l10n:Localize.ToolTip="settings.shortcut-reset">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                            </Button>
                            <TextBlock Grid.Row="1" l10n:Localize.Text="settings.shortcut-game" VerticalAlignment="Center" />
                            <Button x:Name="GameShortcutButton" Grid.Row="1" Grid.Column="1" MinWidth="160" Click="ShortcutButton_Click"
                                    PreviewKeyDown="ShortcutButton_PreviewKeyDown" LostFocus="ShortcutButton_LostFocus" />
                            <Button x:Name="GameShortcutReset" Grid.Row="1" Grid.Column="2" Click="ShortcutReset_Click"
                                    l10n:Localize.Name="settings.shortcut-reset" l10n:Localize.ToolTip="settings.shortcut-reset">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="settings.appearance" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <kitc:LanguageSetting x:Name="LanguageRow" />
                    <kitc:ThemeSetting x:Name="ThemeRow" />
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="settings.reset" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <kitc:ResetSetting x:Name="ResetRow" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
