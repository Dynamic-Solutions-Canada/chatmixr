<Window
    x:Class="ChatMixr.Windows.MixFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization"
    xmlns:cls="using:ChatMixr.Classes"
    Title="ChatMixr">
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="18,14,14,10">
            <TextBlock l10n:Localize.Text="flyout.header" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <!-- One card per device (DeviceList); drag a card to reorder -->
        <ListView x:Name="Devices" Grid.Row="1" Padding="10,0,10,4">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- The volume row, then warnings, each only when it applies: the relay failing, the cable as the default
             microphone, and Sonar taking the apps' audio. Always outside the Options section, so never hidden -->
        <StackPanel Grid.Row="2" Padding="18,0,14,0">
            <!-- The device in use's own volume, as Windows' volume control sets it: mute button, slider, level -->
            <!-- Only when the relay can't play the cable -->
            <TextBlock x:Name="InGameChatProblem" l10n:Localize.Text="chat-device.status-failed" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <ContentPresenter x:Name="MicrophoneHost" Margin="0,0,0,10" />
            <StackPanel x:Name="SonarPanel" Padding="0,0,0,10" Visibility="Collapsed" />
        </StackPanel>


        <!-- Footer -->
        <Grid Grid.Row="3" Padding="10,8,10,8" ColumnSpacing="8"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The device in use's volume: mute, slider, level (collapsed when nothing is in use) -->
            <Grid x:Name="VolumeRow" ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MuteButton" Click="MuteButton_Click" Padding="8,6,8,6" Background="Transparent" BorderThickness="0">
                    <FontIcon x:Name="MuteIcon" FontSize="16" />
                </Button>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1"
                        IsThumbToolTipEnabled="False" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                <TextBlock x:Name="VolumeText" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>
            <!-- Options: in-game voice chat (with what to pick in games, or where to set it up), headset
                 auto-switching and the mix shortcuts, in a panel above the button; the same switches as
                 the Settings and Chat apps pages -->
            <Button x:Name="OptionsButton" Grid.Column="1" Padding="8,6,8,6" VerticalAlignment="Center"
                    l10n:Localize.Name="flyout.options" l10n:Localize.ToolTip="flyout.options">
                <FontIcon Glyph="&#xE9E9;" FontSize="16" />
                <Button.Flyout>
                    <Flyout x:Name="OptionsFlyout" Placement="TopEdgeAlignedRight">
                        <Flyout.FlyoutPresenterStyle>
                            <!-- No sideways scrolling: with it, the panel measures its content at unlimited width,
                                 so text never wraps and each switch's help icon ends up past the right edge -->
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="MaxWidth" Value="400" />
                                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Spacing="6" Width="352">
                            <cls:LabeledSwitch x:Name="InGameChatSwitch" Toggled="InGameChatSwitch_Toggled" />
                            <!-- No cable installed yet: where to set up in-game voice chat instead of the switch -->
                            <HyperlinkButton x:Name="SetUpInGameChat" Click="SetUpInGameChat_Click" Padding="0" Visibility="Collapsed"
                                             l10n:Localize.Content="in-game-chat.set-up" />
                            <!-- While the switch is on: the device to pick in games and chat apps -->
                            <TextBlock x:Name="InGameChatInstruction" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,-4,0,8" Visibility="Collapsed" />
                            <cls:LabeledSwitch x:Name="AutoSwitchSwitch" Toggled="AutoSwitchSwitch_Toggled" />
                            <cls:LabeledSwitch x:Name="AutoSwitchDevicesSwitch" Toggled="AutoSwitchDevicesSwitch_Toggled" />
                            <cls:LabeledSwitch x:Name="ShortcutsSwitch" Toggled="ShortcutsSwitch_Toggled" />
                            <!-- Turning the shortcuts on found one already taken by another app -->
                            <TextBlock x:Name="ShortcutsProblem" l10n:Localize.Text="settings.shortcuts-taken" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!-- The main window, where devices, chat apps and settings live -->
            <Button Grid.Column="2" Click="Open_Click" Padding="8,6,8,6" VerticalAlignment="Center"
                    l10n:Localize.Name="flyout.open-tip" l10n:Localize.ToolTip="flyout.open-tip">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>
    </Grid>
</Window>
