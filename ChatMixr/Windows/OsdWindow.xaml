<Window
    x:Class="ChatMixr.Windows.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ChatMixr Popup">
    <!-- ChatMixr's one passing popup. Two faces, one shown at a time (OsdWindow.Present*):
         the mix, and the device just switched to.
         The mix is styled after Windows' own volume popup: a game icon, a thick rounded bar, a chat icon. The bar
         fills in the accent colour from its centre toward the side the mix leans, and a line marks where the
         mix sits, moving out from the centre (MixOsd.ShowPosition). -->
    <Grid x:Name="WindowRoot">
    <Grid x:Name="MixPanel" Padding="20,0,20,0" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <FontIcon Glyph="&#xE7FC;" FontSize="18" VerticalAlignment="Center" />

        <Grid Grid.Column="1" VerticalAlignment="Center" Height="16">
            <!-- Track -->
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            <!-- Fill: three columns sized in code (before, fill, after) -->
            <Grid x:Name="FillGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BeforeColumn" Width="*" />
                    <ColumnDefinition x:Name="FillColumn" Width="0" />
                    <ColumnDefinition x:Name="AfterColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" />
            </Grid>
            <!-- The line marking where the mix sits: it moves out from the centre with the fill's end -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LineBeforeColumn" Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="LineAfterColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" Width="3" Height="16" CornerRadius="1.5" Margin="-1.5,0,-1.5,0" Background="{ThemeResource TextFillColorPrimaryBrush}" />
            </Grid>
        </Grid>

        <FontIcon Grid.Column="2" Glyph="&#xE8BD;" FontSize="18" VerticalAlignment="Center" />
    </Grid>

    <!-- The device ChatMixr just switched to: its kind icon, its name, the device it belongs to -->
    <Grid x:Name="DevicePanel" Padding="20,0,20,0" ColumnSpacing="14" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="DeviceIcon" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
            <TextBlock x:Name="DeviceName" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DeviceAdapter" Style="{StaticResource TertiaryCaptionStyle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
    </Grid>
</Window>
