<Application
    x:Class="ChatMixr.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- The family's page, card and button styles (UI-3), from winui-app-kit's shared XAML -->
                <ResourceDictionary Source="ms-appx:///WinUIAppKit/Styles.xaml" />
                <!-- ChatMixr's styles for rows, badges and notes built in code -->
                <ResourceDictionary Source="ms-appx:///Styles/RowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
