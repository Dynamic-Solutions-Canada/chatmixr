{
  "project": "ChatMixr/ChatMixr.csproj",
  "package_script": "external/winui-app-kit/build/build-msix.ps1",
  "msix_dir": "ChatMixrMSIX",
  "extra_folders": [
    { "source": "ChatMixrMSIX/GameBarIcons", "destination": "GameBar/Icons" }
  ],
  "companions": [
    {
      "project": "ChatMixr.GameBar/ChatMixr.GameBar.csproj",
      "builder": "msbuild",
      "requires": [["Microsoft.VisualStudio.ComponentGroup.UWP.BuildTools", "Microsoft.VisualStudio.Workload.Universal"]],
      "xaml": true,
      "files": ["ChatMixr.GameBar.exe", "Microsoft.Gaming.XboxGameBar.dll", "Microsoft.Gaming.XboxGameBar.winmd", "Microsoft.Gaming.XboxGameBar.Private.winmd"]
    }
  ],
  "manifest_strings": {
    "catalog_dir": "ChatMixr/Localization/Catalogs"
  },
  "package_output": "ChatMixrMSIX/bin/msix-output",
  "certificate": ".windows-build/signing.pfx",
  "version_file": "Directory.Build.props",
  "dev_identity": "TechnicallyReal.ChatMixr",
  "signing": "shared-dev",
  "trusted_certificate": true,
  "store_identity": "DynamicSolutionsCA.ChatMixr",
  "store_publisher": "CN=B55B96A5-F10C-49D3-8D0B-7260EDBE7625",
  "store_identity_switch": "-StoreIdentity",
  "localization": {
    "catalog_dir": "ChatMixr/Localization/Catalogs",
    "source_dirs": ["ChatMixr", "ChatMixr.GameBar"],
    "extra_key_patterns": [
      "DescriptionKey\\s*=\\s*\"([^\"]+)\"",
      "LabelKey\\s*=\\s*\"([^\"]+)\"",
      "HelpKey\\s*=\\s*\"([^\"]+)\""
    ]
  },
  "listing": {
    "product_name": "ChatMixr"
  },
  "notices": {
    "about_source": "ChatMixr/Classes/AboutContent.cs",
    "product_name": "ChatMixr"
  }
}
